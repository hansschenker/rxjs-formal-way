  "rules": [
    {
      "id": "S13-LAST-INIT",
      "from": "Unsubscribed",
      "event": "subscribe",
      "to": "Active",
      "guard": "fresh subscription",
      "actions": [
        "subscribe source"
      ],
      "nextState": "updated control and subscription-local memory",
      "obligations": [
        "S13-LAST-INIT"
      ],
      "explanation": "No candidate is present initially, including no phantom undefined candidate."
    },
    {
      "id": "S13-LAST-TAKE",
      "from": "Active",
      "event": "source.next",
      "to": "Active",
      "guard": "no predicate configured",
      "actions": [
        "store last value; no output"
      ],
      "nextState": "updated control and subscription-local memory",
      "obligations": [
        "S13-LAST-TAKE"
      ],
      "explanation": "Overwrite the candidate on every input without retaining older elements."
    },
    {
      "id": "S13-LAST-CHECK",
      "from": "Active",
      "event": "source.next",
      "to": "Calling",
      "guard": "predicate configured and source value arrives",
      "actions": [
        "invoke indexed predicate"
      ],
      "nextState": "updated control and subscription-local memory",
      "obligations": [
        "S13-LAST-CHECK"
      ],
      "explanation": "Do not decide acceptance before the external callback outcome."
    },
    {
      "id": "S13-LAST-MATCH",
      "from": "Calling",
      "event": "callback.return",
      "to": "Active",
      "guard": "correlated callback returned truthy",
      "actions": [
        "remember pending value"
      ],
      "nextState": "updated control and subscription-local memory",
      "obligations": [
        "S13-LAST-MATCH"
      ],
      "explanation": "Last matching value replaces the previous candidate; no next yet."
    },
    {
      "id": "S13-LAST-REJECT",
      "from": "Calling",
      "event": "callback.return",
      "to": "Active",
      "guard": "correlated callback returned falsy",
      "actions": [
        "keep previous candidate"
      ],
      "nextState": "updated control and subscription-local memory",
      "obligations": [
        "S13-LAST-REJECT"
      ],
      "explanation": "Predicate selection is a local state policy, not output filtering yet."
    },
    {
      "id": "S13-LAST-PREDICATE-ERROR",
      "from": "Calling",
      "event": "callback.throw",
      "to": "Closed",
      "guard": "correlated callback throws",
      "actions": [
        "forward same error",
        "release source"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-PREDICATE-ERROR"
      ],
      "explanation": "An exception aborts the selection; no fallback is emitted."
    },
    {
      "id": "S13-LAST-EMIT-LAST",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "candidate exists",
      "actions": [
        "emit last candidate",
        "complete",
        "release source"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-EMIT-LAST"
      ],
      "explanation": "Only successful completion can expose the retained candidate."
    },
    {
      "id": "S13-LAST-EMIT-DEFAULT",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "no candidate and default was explicitly supplied",
      "actions": [
        "emit fallback",
        "complete",
        "release source"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-EMIT-DEFAULT"
      ],
      "explanation": "An explicit undefined fallback is distinct from no argument."
    },
    {
      "id": "S13-LAST-EMPTY-ERROR",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "no candidate and default absent",
      "actions": [
        "emit EmptyError",
        "release source"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-EMPTY-ERROR"
      ],
      "explanation": "No matching input is an error without a configured fallback."
    },
    {
      "id": "S13-LAST-SOURCE-ERROR",
      "from": "Active",
      "event": "source.error",
      "to": "Closed",
      "guard": "source errors",
      "actions": [
        "forward exact error",
        "release source"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-SOURCE-ERROR"
      ],
      "explanation": "No candidate or fallback is emitted when source fails."
    },
    {
      "id": "S13-LAST-CANCEL",
      "from": "Active",
      "event": "cancel",
      "to": "Closed",
      "guard": "consumer closes",
      "actions": [
        "release source silently"
      ],
      "nextState": "terminal with no owned work",
      "obligations": [
        "S13-LAST-CANCEL"
      ],
      "explanation": "A cancelled stream never emits the retained value."
    }
  ]
}
