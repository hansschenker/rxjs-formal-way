{
  "metadata": {
    "schemaVersion": "1.1",
    "rxjsVersion": "7.8.2",
    "id": "last-predicate-required",
    "operator": "last",
    "purpose": "Retain the final selected source value; reveal exactly one result only after source completes successfully.",
    "cardinality": {
      "signature": "last(P?,D?) : T* -> (T|D)?",
      "conditions": [
        "No downstream next before successful source completion.",
        "A matching candidate yields one next then complete. No candidate yields explicit default or EmptyError.",
        "Predicate indices count all source next notifications, including those rejected.",
        "Cω describes next cardinality. Error, complete, cancellation, and resource release are separate events."
      ]
    },
    "scope": {
      "parameters": "Predicate enabled true; explicit default supplied false; default can be undefined.",
      "callbacks": "When selected, indexed predicate receives source value/index/original source; pure model requests callback and receives a correlated truthy/falsy or throw event.",
      "time": "No timer. Output occurs at successful source completion time; cancellation or error produces no retained candidate.",
      "reentrancy": "Atomic non-reentrant source and callback-outcome steps. User observers may not synchronously re-enter the modeled execution.",
      "exclusions": [
        "Deprecated thisArg/BooleanConstructor type-narrowing signatures as distinct run-time policies; reentrant callback/source; observer throwing."
      ]
    },
    "initialization": {
      "control": "Unsubscribed",
      "event": "subscribe",
      "sourceSubscription": "Acquire one upstream subscription only when the resulting Observable is subscribed."
    },
    "ownership": {
      "state": "subscription-local",
      "sharing": "No sharing, replay, or global storage; every output subscription has an independent machine.",
      "reset": "Fresh state on each output subscription; Closed rejects later events.",
      "resources": [
        {
          "id": "source",
          "kind": "subscription",
          "owner": "current result subscription"
        },
        {
          "id": "predicate",
          "kind": "callback",
          "owner": "one indexed last predicate invocation"
        }
      ]
    },
    "dispatch": {
      "policy": "atomic-non-reentrant",
      "actionSemantics": "Commit state, then deliver ordered next/terminal/connection actions. Callback outcomes are supplied externally.",
      "cancellationCheckpoints": [
        "Between resolved source events; silence on cancellation."
      ]
    },
    "inputs": [
      {
        "type": "subscribe",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "start a fresh lazy execution"
      },
      {
        "type": "source.next",
        "origin": "source",
        "category": "notification",
        "description": "receive an opaque source value"
      },
      {
        "type": "source.complete",
        "origin": "source",
        "category": "notification",
        "description": "normal source completion"
      },
      {
        "type": "source.error",
        "origin": "source",
        "category": "notification",
        "description": "source failure with original error identity"
      },
      {
        "type": "cancel",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "silent downstream cancellation"
      },
      {
        "type": "callback.return",
        "origin": "callback",
        "category": "callback",
        "description": "indexed predicate returned truthy or falsy"
      },
      {
        "type": "callback.throw",
        "origin": "callback",
        "category": "callback",
        "description": "indexed predicate threw the original error object"
      }
    ],
    "actionTypes": [
      "subscribe",
      "unsubscribe",
      "notify",
      "invoke-callback"
    ],
    "controls": [
      {
        "id": "Unsubscribed",
        "description": "description exists, source is not yet connected",
        "terminal": false
      },
      {
        "id": "Active",
        "description": "one source execution is connected",
        "terminal": false
      },
      {
        "id": "Calling",
        "description": "one indexed predicate invocation is awaiting a correlated outcome",
        "terminal": false
      },
      {
        "id": "Closed",
        "description": "completed, failed or cancelled; no later events are legal",
        "terminal": true
      }
    ],
