        "purpose": "Pinned RxJS 7.8.2 behavior and teardown evidence"
      },
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/operators/throwIfEmpty.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
        "purpose": "Pinned RxJS 7.8.2 behavior and teardown evidence"
      }
    ],
    "evidence": {
      "modelTests": [
        "tests/session12-model.test.mjs"
      ],
      "runtimeTests": [
        "tests/session12-rxjs.test.mjs"
      ],
      "status": "source-inspected",
      "record": "evidence/SESSION-12.md"
    }
  },
  "parameters": {
    "predicate": true,
    "hasDefault": false,
    "predicateId": "predicate"
  },
  "rules": [
    {
      "id": "FIRST-INIT",
      "from": "Unsubscribed",
      "event": "subscribe",
      "to": "Active",
      "guard": "fresh execution",
      "actions": [
        "subscribe source"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FIRST-INIT"
      ],
      "explanation": "First waits for the first admissible value."
    },
    {
      "id": "FIRST-DIRECT",
      "from": "Active",
      "event": "source.next",
      "to": "Closed",
      "guard": "predicate omitted",
      "actions": [
        "emit first source value",
        "complete",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-DIRECT"
      ],
      "explanation": "Without a predicate, the first source value terminates immediately."
    },
    {
      "id": "FIRST-CALL",
      "from": "Active",
      "event": "source.next",
      "to": "Calling",
      "guard": "predicate supplied and index valid",
      "actions": [
        "invoke predicate"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FIRST-CALL"
      ],
      "explanation": "With a predicate, first tests values until the first truthy result."
    },
    {
      "id": "FIRST-MATCH",
      "from": "Calling",
      "event": "callback.return",
      "to": "Closed",
      "guard": "correlated truthy predicate result",
      "actions": [
        "emit original matched value",
        "complete",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-MATCH"
      ],
      "explanation": "The first matching source value is forwarded unchanged."
    },
    {
      "id": "FIRST-MISS",
      "from": "Calling",
      "event": "callback.return",
      "to": "Active",
      "guard": "correlated falsy predicate result",
      "actions": [
        "advance predicate index silently"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FIRST-MISS"
      ],
      "explanation": "Rejected values are skipped but consume their source index."
    },
    {
      "id": "FIRST-THROW",
      "from": "Calling",
      "event": "callback.throw",
      "to": "Closed",
      "guard": "correlated predicate throw",
      "actions": [
        "error downstream",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-THROW"
      ],
      "explanation": "Predicate exceptions remain errors."
    },
    {
      "id": "FIRST-EMPTY-DEFAULT",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "no admissible value and explicit default supplied",
      "actions": [
        "emit default",
        "complete",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-EMPTY-DEFAULT"
      ],
      "explanation": "Explicit undefined is still a supplied default when argument two exists."
    },
    {
      "id": "FIRST-EMPTY-ERROR",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "no admissible value and no default",
      "actions": [
        "error with EmptyError",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-EMPTY-ERROR"
      ],
      "explanation": "Unlike find, first has an error policy for no matching value unless a default was supplied."
    },
    {
      "id": "FIRST-SOURCE-ERROR",
      "from": "Active",
      "event": "source.error",
      "to": "Closed",
      "guard": "source errors",
      "actions": [
        "forward exact error",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-SOURCE-ERROR"
      ],
      "explanation": "Source failure suppresses default and EmptyError synthesis."
    },
    {
      "id": "FIRST-CANCEL",
      "from": "Active",
      "event": "cancel",
      "to": "Closed",
      "guard": "downstream closes",
      "actions": [
        "release source silently"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FIRST-CANCEL"
      ],
      "explanation": "Cancellation emits no default and no EmptyError."
    }
  ]
}
