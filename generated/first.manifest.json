{
  "metadata": {
    "schemaVersion": "1.1",
    "rxjsVersion": "7.8.2",
    "id": "first-predicate-required",
    "operator": "first",
    "purpose": "Emit the first source value, or first predicate match; on successful exhaustion emit an explicit default or error with EmptyError.",
    "cardinality": {
      "signature": "first(P?,D?) : T* -> (T|D)?",
      "conditions": [
        "At most one next value is emitted.",
        "Predicate mode short-circuits on first truthy result; direct mode short-circuits on first source value.",
        "Cω counts next values; terminal notifications, cancellation and resource release are separate obligations."
      ]
    },
    "scope": {
      "parameters": "predicate supplied; no default supplied",
      "callbacks": "One correlated predicate outcome per tested value.",
      "time": "No timer; first admissible source position controls output.",
      "reentrancy": "One pending predicate outcome at a time.",
      "exclusions": [
        "Type-guard/BooleanConstructor specialization, deprecated overload nuances, callback/observer/finalizer reentry."
      ]
    },
    "initialization": {
      "control": "Unsubscribed",
      "event": "subscribe",
      "sourceSubscription": "Acquire one source subscription only when the result is subscribed."
    },
    "ownership": {
      "state": "subscription-local",
      "sharing": "No sharing is introduced; each result subscription owns independent state and resources.",
      "reset": "A fresh result subscription starts from Unsubscribed; Closed rejects all later model events.",
      "resources": [
        {
          "id": "source",
          "kind": "subscription",
          "owner": "current result subscription"
        },
        {
          "id": "predicate",
          "kind": "callback",
          "owner": "present only when predicate profile is selected"
        }
      ]
    },
    "dispatch": {
      "policy": "atomic-non-reentrant",
      "actionSemantics": "Commit next state, then interpret ordered actions. Callback actions are requests to external user functions, never executed by the pure model.",
      "cancellationCheckpoints": [
        "Between fully resolved reactions; cancellation releases owned work and emits no synthetic completion."
      ]
    },
    "inputs": [
      {
        "type": "subscribe",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "begin a fresh lazy execution"
      },
      {
        "type": "source.next",
        "origin": "source",
        "category": "notification",
        "description": "source delivers an opaque value"
      },
      {
        "type": "source.complete",
        "origin": "source",
        "category": "notification",
        "description": "source completes successfully"
      },
      {
        "type": "source.error",
        "origin": "source",
        "category": "notification",
        "description": "source fails with its original error object"
      },
      {
        "type": "cancel",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "downstream unsubscribes silently"
      },
      {
        "type": "callback.return",
        "origin": "callback",
        "category": "callback",
        "description": "correlated predicate returns a truthy/falsy result"
      },
      {
        "type": "callback.throw",
        "origin": "callback",
        "category": "callback",
        "description": "correlated predicate throws"
      }
    ],
    "actionTypes": [
      "subscribe",
      "unsubscribe",
      "invoke-callback",
      "notify"
    ],
    "controls": [
      {
        "id": "Unsubscribed",
        "description": "cold description; nothing connected yet",
        "terminal": false
      },
      {
        "id": "Active",
        "description": "source connected with subscription-local state",
        "terminal": false
      },
      {
        "id": "Calling",
        "description": "predicate outcome pending in predicate profile",
        "terminal": false
      },
      {
        "id": "Closed",
        "description": "terminal execution; no later model events are legal",
        "terminal": true
      }
    ],
    "sources": [
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/operators/first.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
