{
  "metadata": {
    "schemaVersion": "1.1",
    "id": "catchError-one-Observable-replacement",
    "operator": "catchError",
    "rxjsVersion": "7.8.2",
    "purpose": "Forward source values; on the first source error, invoke a selector and subscribe to its replacement stream.",
    "cardinality": {
      "signature": "catchError : T* × (E -> R*) -> (T|R)*",
      "conditions": [
        "Source next values flow unchanged until source error or completion.",
        "One source error is intercepted, not delivered downstream, and replaced by zero or more values from the selected Observable.",
        "Replacement completion completes output; replacement error propagates without another selector call in this scoped single-replacement execution."
      ]
    },
    "scope": {
      "parameters": "One source and one Observable replacement, without recursive caught resubscription.",
      "callbacks": "The selector receives the exact error and a caught Observable. The model requests a correlated callback invocation and receives a resolved return/throw event; it does not execute user code.",
      "time": "No new timing policy. The replacement Observable determines emission times; synchronous source errors require original-source teardown before replacement connection.",
      "reentrancy": "Model resolution of synchronous selector call is atomic; no arbitrary recursion/reentrant downstream/finalizer behavior.",
      "exclusions": [
        "Selectors returning Promise or arbitrary ObservableInput conversion; returning caught recursively; synchronous reentrant producer or observer behavior.",
        "Selector cancellation in the middle of execution and observer/finalizer throws.",
        "A universal retry/resubscription model, which must be specified separately."
      ]
    },
    "initialization": {
      "control": "Unsubscribed",
      "event": "subscribe",
      "sourceSubscription": "Connect original source; no replacement subscription until first source error is handled."
    },
    "ownership": {
      "state": "subscription-local",
      "sharing": "No sharing; each output subscription owns its original and possible replacement source subscriptions.",
      "reset": "Error handling is local to one execution; replacement does not reset upstream history unless the selected Observable explicitly does.",
      "resources": [
        {
          "id": "source",
          "kind": "subscription",
          "owner": "current execution"
        },
        {
          "id": "replacement",
          "kind": "subscription",
          "owner": "current execution"
        },
        {
          "id": "selector",
          "kind": "callback",
          "owner": "current execution"
        }
      ]
    },
    "dispatch": {
      "policy": "atomic-non-reentrant",
      "actionSemantics": "Forward source.next until source.error; invoke selector; on return release original source before subscribing replacement; replacement notifications flow unchanged.",
      "cancellationCheckpoints": [
        "Cancel silently before failure, during pending selector outcome, or during replacement.",
        "No implicit retry, timer, or sharing."
      ]
    },
    "inputs": [
      {
        "type": "subscribe",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "start source subscription"
      },
      {
        "type": "source.next",
        "origin": "source",
        "category": "notification",
        "description": "forward original value"
      },
      {
        "type": "source.complete",
        "origin": "source",
        "category": "notification",
        "description": "complete without selector"
      },
      {
        "type": "source.error",
        "origin": "source",
        "category": "notification",
        "description": "invoke recovery selector"
      },
      {
        "type": "callback.return",
        "origin": "callback",
        "category": "callback",
        "description": "replacement Observable returned"
      },
      {
        "type": "callback.throw",
        "origin": "callback",
        "category": "callback",
        "description": "recovery selector threw"
      },
      {
        "type": "replacement.next",
        "origin": "inner",
        "category": "notification",
        "description": "forward replacement value"
      },
      {
        "type": "replacement.complete",
        "origin": "inner",
        "category": "notification",
        "description": "complete replacement"
      },
      {
        "type": "replacement.error",
        "origin": "inner",
        "category": "notification",
        "description": "propagate replacement error without catching again"
      },
      {
        "type": "cancel",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "silent teardown"
      }
    ],
    "actionTypes": [
      "subscribe",
      "unsubscribe",
      "notify",
      "invoke-callback"
    ],
    "controls": [
      {
        "id": "Unsubscribed",
        "description": "not started",
        "terminal": false
      },
      {
        "id": "Source",
        "description": "original source running",
        "terminal": false
      },
      {
        "id": "Calling",
        "description": "selector outcome pending",
        "terminal": false
      },
      {
        "id": "Replacement",
        "description": "recovery Observable running",
        "terminal": false
      },
      {
        "id": "Closed",
        "description": "completed, errored or cancelled",
        "terminal": true
      }
    ],
    "sources": [
