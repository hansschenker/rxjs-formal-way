  "parameters": {
    "operator": "catchError",
    "replacement": "one-Observable"
  },
  "rules": [
    {
      "id": "CATCHERROR-INIT",
      "from": "Unsubscribed",
      "event": "subscribe",
      "to": "Source",
      "guard": "fresh execution",
      "actions": [
        "subscribe original source"
      ],
      "nextState": "await or execute selected source",
      "obligations": [
        "S8-CATCHERROR-INIT"
      ],
      "explanation": "Only a subscriber starts source work."
    },
    {
      "id": "CATCHERROR-SOURCE-NEXT",
      "from": "Source",
      "event": "source.next",
      "to": "Source",
      "guard": "original connected",
      "actions": [
        "forward exact value"
      ],
      "nextState": "await or execute selected source",
      "obligations": [
        "S8-CATCHERROR-SOURCE-NEXT"
      ],
      "explanation": "The source value is forwarded without transformation."
    },
    {
      "id": "CATCHERROR-SOURCE-ERROR",
      "from": "Source",
      "event": "source.error",
      "to": "Calling",
      "guard": "source connected",
      "actions": [
        "request recovery selector with error and caught source"
      ],
      "nextState": "await or execute selected source",
      "obligations": [
        "S8-CATCHERROR-SOURCE-ERROR"
      ],
      "explanation": "The original error is not sent downstream; it is handed to selector."
    },
    {
      "id": "CATCHERROR-SELECTOR-RETURN",
      "from": "Calling",
      "event": "callback.return",
      "to": "Replacement",
      "guard": "matching callback resource",
      "actions": [
        "release original source",
        "subscribe replacement Observable"
      ],
      "nextState": "await or execute selected source",
      "obligations": [
        "S8-CATCHERROR-SELECTOR-RETURN"
      ],
      "explanation": "The original producer is finalized before recovery subscribes, even after a synchronous error."
    },
    {
      "id": "CATCHERROR-SELECTOR-THROW",
      "from": "Calling",
      "event": "callback.throw",
      "to": "Closed",
      "guard": "matching selector (or synchronous throw without resource)",
      "actions": [
        "error with thrown value",
        "release source"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-SELECTOR-THROW"
      ],
      "explanation": "Selector failure terminates without subscribing replacement."
    },
    {
      "id": "CATCHERROR-SOURCE-COMPLETE",
      "from": "Source",
      "event": "source.complete",
      "to": "Closed",
      "guard": "original connected",
      "actions": [
        "complete",
        "release original source"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-SOURCE-COMPLETE"
      ],
      "explanation": "Successful completion never invokes recovery selector."
    },
    {
      "id": "CATCHERROR-REPLACEMENT-NEXT",
      "from": "Replacement",
      "event": "replacement.next",
      "to": "Replacement",
      "guard": "replacement connected",
      "actions": [
        "forward replacement value"
      ],
      "nextState": "await or execute selected source",
      "obligations": [
        "S8-CATCHERROR-REPLACEMENT-NEXT"
      ],
      "explanation": "Every replacement value is forwarded unchanged."
    },
    {
      "id": "CATCHERROR-REPLACEMENT-COMPLETE",
      "from": "Replacement",
      "event": "replacement.complete",
      "to": "Closed",
      "guard": "replacement connected",
      "actions": [
        "complete",
        "release replacement"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-REPLACEMENT-COMPLETE"
      ],
      "explanation": "Output completes when recovery finishes."
    },
    {
      "id": "CATCHERROR-REPLACEMENT-ERROR",
      "from": "Replacement",
      "event": "replacement.error",
      "to": "Closed",
      "guard": "replacement connected",
      "actions": [
        "propagate replacement error",
        "release replacement"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-REPLACEMENT-ERROR"
      ],
      "explanation": "Errors from the replacement are not intercepted by the same selector."
    },
    {
      "id": "CATCHERROR-CANCEL-SOURCE",
      "from": "Source",
      "event": "cancel",
      "to": "Closed",
      "guard": "active subscription",
      "actions": [
        "unsubscribe current resource without output"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-CANCEL-SOURCE"
      ],
      "explanation": "Explicit cancellation never synthesizes a complete or error notification."
    },
    {
      "id": "CATCHERROR-CANCEL-CALLING",
      "from": "Calling",
      "event": "cancel",
      "to": "Closed",
      "guard": "active subscription",
      "actions": [
        "unsubscribe current resource without output"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-CANCEL-CALLING"
      ],
      "explanation": "Explicit cancellation never synthesizes a complete or error notification."
    },
    {
      "id": "CATCHERROR-CANCEL-REPLACEMENT",
      "from": "Replacement",
      "event": "cancel",
      "to": "Closed",
      "guard": "active subscription",
      "actions": [
        "unsubscribe current resource without output"
      ],
      "nextState": "closed",
      "obligations": [
        "S8-CATCHERROR-CANCEL-REPLACEMENT"
      ],
      "explanation": "Explicit cancellation never synthesizes a complete or error notification."
    }
  ]
}
