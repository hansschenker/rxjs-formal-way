  "rules": [
    {
      "id": "FINDINDEX-INIT",
      "from": "Unsubscribed",
      "event": "subscribe",
      "to": "Active",
      "guard": "fresh execution",
      "actions": [
        "subscribe source with index zero"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FINDINDEX-INIT"
      ],
      "explanation": "findIndex evaluates source values in order."
    },
    {
      "id": "FINDINDEX-CALL",
      "from": "Active",
      "event": "source.next",
      "to": "Calling",
      "guard": "valid zero-based index",
      "actions": [
        "invoke predicate"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FINDINDEX-CALL"
      ],
      "explanation": "Predicate receives original value and current source index."
    },
    {
      "id": "FINDINDEX-MATCH",
      "from": "Calling",
      "event": "callback.return",
      "to": "Closed",
      "guard": "correlated truthy result",
      "actions": [
        "emit current index",
        "complete",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FINDINDEX-MATCH"
      ],
      "explanation": "The output is the zero-based position of the first matching value."
    },
    {
      "id": "FINDINDEX-MISS",
      "from": "Calling",
      "event": "callback.return",
      "to": "Active",
      "guard": "correlated falsy result",
      "actions": [
        "advance index silently"
      ],
      "nextState": "updated control and memory",
      "obligations": [
        "S12-FINDINDEX-MISS"
      ],
      "explanation": "A rejected value consumes its index."
    },
    {
      "id": "FINDINDEX-THROW",
      "from": "Calling",
      "event": "callback.throw",
      "to": "Closed",
      "guard": "correlated predicate throw",
      "actions": [
        "error downstream",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FINDINDEX-THROW"
      ],
      "explanation": "Predicate errors do not become -1."
    },
    {
      "id": "FINDINDEX-NOT-FOUND",
      "from": "Active",
      "event": "source.complete",
      "to": "Closed",
      "guard": "no value matched",
      "actions": [
        "emit -1",
        "complete",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FINDINDEX-NOT-FOUND"
      ],
      "explanation": "No match is a successful -1 result, not an error."
    },
    {
      "id": "FINDINDEX-SOURCE-ERROR",
      "from": "Active",
      "event": "source.error",
      "to": "Closed",
      "guard": "source errors",
      "actions": [
        "forward exact error",
        "release source"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FINDINDEX-SOURCE-ERROR"
      ],
      "explanation": "Source error suppresses -1."
    },
    {
      "id": "FINDINDEX-CANCEL",
      "from": "Active",
      "event": "cancel",
      "to": "Closed",
      "guard": "downstream closes",
      "actions": [
        "release source silently"
      ],
      "nextState": "terminal state with no owned live work",
      "obligations": [
        "S12-FINDINDEX-CANCEL"
      ],
      "explanation": "Cancellation emits no sentinel."
    }
  ]
