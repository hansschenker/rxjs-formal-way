{
  "metadata": {
    "schemaVersion": "1.1",
    "rxjsVersion": "7.8.2",
    "id": "findIndex-first-match",
    "operator": "findIndex",
    "purpose": "Emit the zero-based index of the first source value whose predicate is truthy; emit -1 if no match exists.",
    "cardinality": {
      "signature": "findIndex : (T! x Index! -> Boolean!) -> T* -> Number!",
      "conditions": [
        "Finite successful execution emits exactly one integer: first matching index or -1.",
        "First truthy result short-circuits source work.",
        "Cω counts next values; terminal notifications, cancellation and resource release are separate obligations."
      ]
    },
    "scope": {
      "parameters": "Required predicate; deprecated thisArg and BooleanConstructor specialization excluded.",
      "callbacks": "One correlated predicate outcome per tested value.",
      "time": "No timer; source order defines index.",
      "reentrancy": "One pending predicate result at a time.",
      "exclusions": [
        "Deprecated thisArg overload, callback reentry, observer/finalizer exceptions."
      ]
    },
    "initialization": {
      "control": "Unsubscribed",
      "event": "subscribe",
      "sourceSubscription": "Acquire one source subscription only when the result is subscribed."
    },
    "ownership": {
      "state": "subscription-local",
      "sharing": "No sharing is introduced; each result subscription owns independent state and resources.",
      "reset": "A fresh result subscription starts from Unsubscribed; Closed rejects all later model events.",
      "resources": [
        {
          "id": "source",
          "kind": "subscription",
          "owner": "current result subscription"
        },
        {
          "id": "predicate",
          "kind": "callback",
          "owner": "one invocation per tested value"
        }
      ]
    },
    "dispatch": {
      "policy": "atomic-non-reentrant",
      "actionSemantics": "Commit next state, then interpret ordered actions. Callback actions are requests to external user functions, never executed by the pure model.",
      "cancellationCheckpoints": [
        "Between fully resolved reactions; cancellation releases owned work and emits no synthetic completion."
      ]
    },
    "inputs": [
      {
        "type": "subscribe",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "begin a fresh lazy execution"
      },
      {
        "type": "source.next",
        "origin": "source",
        "category": "notification",
        "description": "source delivers an opaque value"
      },
      {
        "type": "source.complete",
        "origin": "source",
        "category": "notification",
        "description": "source completes successfully"
      },
      {
        "type": "source.error",
        "origin": "source",
