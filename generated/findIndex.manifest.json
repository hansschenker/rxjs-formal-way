      },
      {
        "type": "callback.throw",
        "origin": "callback",
        "category": "callback",
        "description": "correlated predicate throws"
      }
    ],
    "actionTypes": [
      "subscribe",
      "unsubscribe",
      "invoke-callback",
      "notify"
    ],
    "controls": [
      {
        "id": "Unsubscribed",
        "description": "cold description; nothing connected yet",
        "terminal": false
      },
      {
        "id": "Active",
        "description": "source connected with subscription-local state",
        "terminal": false
      },
      {
        "id": "Calling",
        "description": "one predicate outcome is pending",
        "terminal": false
      },
      {
        "id": "Closed",
        "description": "terminal execution; no later model events are legal",
        "terminal": true
      }
