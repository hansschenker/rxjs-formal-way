{
  "metadata": {
    "schemaVersion": "1.1",
    "id": "audit-Observable-duration",
    "operator": "audit",
    "rxjsVersion": "7.8.2",
    "purpose": "Start a duration Observable from the first value, retain latest values while it is active, and emit only on its next signal.",
    "cardinality": {
      "signature": "audit : (T! -> U*) -> T* -> T*",
      "conditions": [
        "Emitted values are an ordered subsequence of source values; at most one per duration.",
        "Values arriving during an active duration replace the pending latest value and do not restart it.",
        "Duration next flushes; duration completion without next discards the pending value. Source completion waits for the active duration.",
        "Source error and downstream cancellation discard pending values and release resources."
      ]
    },
    "scope": {
      "parameters": "Named duration selector returning a valid Observable; exactly one live duration Observable per result subscription",
      "callbacks": "Selector invocation is an action; a correlated return represents a valid Observable, without running the selector in guards or in the model runner.",
      "time": "Externally supplied monotone safe-integer clock; duration signals or scheduler firings determine output time. No deadline alone emits a value.",
      "reentrancy": "Atomic non-reentrant source, callback, observer and duration notifications after initialization. Equal timestamps are ordered by trace sequence.",
      "exclusions": [
        "Promise/iterable ObservableInput conversion and synchronous inner notification during subscription setup.",
        "Nested source/duration emissions, cancellation inside callbacks/output delivery and throwing observers/finalizers.",
        "Universal behavioral equivalence, callback purity, and arbitrary external mutation of retained object references."
      ]
    },
    "initialization": {
      "control": "Unsubscribed",
      "event": "subscribe",
      "sourceSubscription": "Connect to source only; first value starts a duration."
    },
    "ownership": {
      "state": "subscription-local",
      "sharing": "No sharing or replay introduced. Each result subscription owns its latest value and duration identity.",
      "reset": "Fresh counter and no pending value per execution; Closed rejects later signals.",
      "resources": [
        {
          "id": "source",
          "kind": "subscription",
          "owner": "current result execution"
        },
        {
          "id": "duration",
          "kind": "subscription",
          "owner": "current execution; at most one live"
        },
        {
          "id": "duration-selector",
          "kind": "callback",
          "owner": "external binding; generation identifies invocation"
        }
      ]
    },
    "dispatch": {
      "policy": "atomic-non-reentrant",
      "actionSemantics": "Only the selector callback outcome may resolve Calling. Inner next releases duration and flushes latest; inner completion only releases duration.",
      "cancellationCheckpoints": [
        "Between resolved notifications; no pending-value flush on cancellation.",
        "Source completion may leave a duration active; it does not force emission or cancel that duration."
      ]
    },
    "inputs": [
      {
        "type": "subscribe",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "acquire a source subscription"
      },
      {
        "type": "source.next",
        "origin": "source",
        "category": "notification",
        "description": "start or update a latest-value window"
      },
      {
        "type": "source.complete",
        "origin": "source",
        "category": "notification",
        "description": "complete when no duration remains, else wait"
      },
      {
        "type": "source.error",
        "origin": "source",
        "category": "notification",
        "description": "error without flushing"
      },
      {
        "type": "cancel",
        "origin": "downstream",
        "category": "lifecycle",
        "description": "stop silently and release resources"
      },
      {
        "type": "callback.return",
        "origin": "callback",
        "category": "callback",
        "description": "duration selector returned a valid Observable"
      },
      {
        "type": "callback.throw",
        "origin": "callback",
        "category": "callback",
        "description": "duration selector threw"
      },
      {
        "type": "duration.next",
        "origin": "inner",
        "category": "notification",
        "description": "active duration emits a next signal"
      },
      {
        "type": "duration.complete",
        "origin": "inner",
        "category": "notification",
        "description": "active duration completes without next"
      },
      {
        "type": "duration.error",
        "origin": "inner",
        "category": "notification",
        "description": "active duration errors"
      }
    ],
    "actionTypes": [
      "subscribe",
      "invoke-callback",
      "notify",
      "unsubscribe"
    ],
    "controls": [
      {
        "id": "Unsubscribed",
        "description": "no subscription",
        "terminal": false
      },
      {
        "id": "Idle",
        "description": "source connected; no duration running",
        "terminal": false
      },
      {
        "id": "Calling",
        "description": "duration-selector return pending",
        "terminal": false
      },
      {
        "id": "Pending",
        "description": "latest source value and active duration remembered",
        "terminal": false
      },
      {
        "id": "Waiting",
        "description": "source completed; awaiting the active duration outcome",
        "terminal": false
      },
      {
        "id": "Closed",
        "description": "terminal or cancelled",
        "terminal": true
      }
    ],
    "sources": [
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/operators/audit.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
        "purpose": "Pinned duration creation, terminal waiting, completion/drop and teardown semantics"
      },
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/observable/innerFrom.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
        "purpose": "Pinned duration creation, terminal waiting, completion/drop and teardown semantics"
      },
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/operators/OperatorSubscriber.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
        "purpose": "Pinned duration creation, terminal waiting, completion/drop and teardown semantics"
      },
      {
        "url": "https://github.com/ReactiveX/rxjs/blob/e5351d02e225e275ac0e497c7b66eaa5f0c88791/src/internal/Subscriber.ts",
        "revision": "e5351d02e225e275ac0e497c7b66eaa5f0c88791",
        "purpose": "Pinned duration creation, terminal waiting, completion/drop and teardown semantics"
      }
    ],
    "evidence": {
      "modelTests": [
        "tests/session07-audit-model.test.mjs"
      ],
      "runtimeTests": [
        "tests/session07-audit-rxjs.test.mjs"
      ],
      "status": "source-inspected",
      "record": "evidence/SESSION-07.md"
    }
  },
  "parameters": {
    "operator": "audit",
    "duration": 0
  },
  "rules": [
    {
      "id": "AUDIT-INIT",
      "from": "Unsubscribed",
      "event": "subscribe",
      "guard": "fresh valid clock",
      "to": "Idle",
      "actions": [
        "subscribe to the source"
      ],
      "nextState": "idle without a duration",
      "explanation": "Construction does not connect. Subscription acquires a source; first next starts a duration.",
      "obligations": [
        "S7-AUDIT-INIT"
      ]
    },
    {
      "id": "AUDIT-START",
      "from": "Idle",
      "event": "source.next",
      "guard": "valid clock, fresh generation and duration deadline",
      "to": "Calling",
      "actions": [
        "invoke durationSelector exactly once with this value"
      ],
      "nextState": "await the correlated duration-selector outcome",
      "explanation": "With no active duration, the first source value is remembered and requests one selector call.",
      "obligations": [
        "S7-AUDIT-START"
      ]
    },
    {
      "id": "AUDIT-REPLACE",
      "from": "Pending",
      "event": "source.next",
      "guard": "duration remains active",
      "to": "Pending",
      "actions": [],
      "nextState": "same duration with latest input replaced",
      "explanation": "Values arriving during an active duration replace the pending value; neither the selector nor timer restarts.",
      "obligations": [
        "S7-AUDIT-REPLACE"
      ]
    },
    {
      "id": "AUDIT-COMPLETE-IDLE",
      "from": "Idle",
      "event": "source.complete",
      "guard": "no active duration",
      "to": "Closed",
      "actions": [
        "complete downstream",
        "release source"
      ],
      "nextState": "closed by completion",
      "explanation": "Without an active duration, completion passes downstream immediately.",
      "obligations": [
        "S7-AUDIT-COMPLETE-IDLE"
      ]
    },
    {
      "id": "AUDIT-COMPLETE-PENDING",
      "from": "Pending",
      "event": "source.complete",
      "guard": "duration active",
      "to": "Waiting",
      "actions": [
        "release completed source; retain duration"
      ],
      "nextState": "waiting for duration outcome, no new source values",
      "explanation": "A source completion with an active duration waits: it does not flush the pending value or cancel its duration.",
      "obligations": [
        "S7-AUDIT-COMPLETE-PENDING"
      ]
    },
    {
      "id": "AUDIT-CALL-RETURN",
      "from": "Calling",
      "event": "callback.return",
      "guard": "matching selector invocation",
      "to": "Pending",
      "actions": [
        "subscribe to returned duration Observable"
      ],
      "nextState": "pending with a duration subscription",
      "explanation": "The selector returns a valid duration Observable; the model subscribes, but does not execute the callback itself.",
      "obligations": [
        "S7-AUDIT-CALL-RETURN"
      ]
    },
    {
      "id": "AUDIT-CALL-THROW",
      "from": "Calling",
      "event": "callback.throw",
      "guard": "matching selector invocation",
      "to": "Closed",
      "actions": [
        "forward thrown value",
        "release source"
      ],
      "nextState": "closed by selector error",
      "explanation": "Throwing durationSelector terminates immediately; no pending value is emitted.",
      "obligations": [
        "S7-AUDIT-CALL-THROW"
      ]
    },
    {
      "id": "AUDIT-DURATION-NEXT",
      "from": "Pending",
      "event": "duration.next",
      "guard": "matching live duration next",
      "to": "Idle",
      "actions": [
        "release active duration",
        "emit latest pending source value"
      ],
      "nextState": "idle and ready for the next source value",
      "explanation": "A duration next ends the window and emits the latest retained source value.",
      "obligations": [
        "S7-AUDIT-DURATION-NEXT"
      ]
    },
    {
      "id": "AUDIT-DURATION-COMPLETE",
      "from": "Pending",
      "event": "duration.complete",
      "guard": "matching duration completion without next",
      "to": "Idle",
      "actions": [
        "release ended duration without emitting a pending value"
      ],
      "nextState": "idle; next source value can start a new duration",
      "explanation": "A duration that only completes is not a next signal. audit does not flush the pending value.",
      "obligations": [
        "S7-AUDIT-DURATION-COMPLETE"
      ]
    },
    {
      "id": "AUDIT-DURATION-ERROR",
      "from": "Pending",
      "event": "duration.error",
      "guard": "matching live duration error",
      "to": "Closed",
      "actions": [
        "forward duration error",
        "release owned resources"
      ],
      "nextState": "closed by duration error",
      "explanation": "An active duration error terminates downstream and discards the pending value.",
      "obligations": [
        "S7-AUDIT-DURATION-ERROR"
      ]
    },
    {
      "id": "AUDIT-WAITING-DURATION-NEXT",
      "from": "Waiting",
      "event": "duration.next",
      "guard": "matching live duration next",
      "to": "Closed",
      "actions": [
        "release active duration",
        "emit latest pending source value",
        "complete downstream"
      ],
      "nextState": "closed by delayed completion",
      "explanation": "After source completion, duration next emits the latest value, then completes.",
      "obligations": [
        "S7-AUDIT-WAITING-DURATION-NEXT"
      ]
    },
    {
      "id": "AUDIT-WAITING-DURATION-COMPLETE",
      "from": "Waiting",
      "event": "duration.complete",
      "guard": "matching duration completion without next",
      "to": "Closed",
      "actions": [
        "release ended duration without emitting a pending value",
        "complete downstream"
      ],
      "nextState": "closed without a flush",
      "explanation": "A duration that only completes is not a next signal. audit does not flush the pending value.",
      "obligations": [
        "S7-AUDIT-WAITING-DURATION-COMPLETE"
      ]
    },
    {
      "id": "AUDIT-WAITING-DURATION-ERROR",
      "from": "Waiting",
      "event": "duration.error",
      "guard": "matching live duration error",
      "to": "Closed",
      "actions": [
        "forward duration error",
        "release owned resources"
      ],
      "nextState": "closed by duration error",
      "explanation": "An active duration error terminates downstream and discards the pending value.",
      "obligations": [
        "S7-AUDIT-WAITING-DURATION-ERROR"
      ]
    },
    {
      "id": "AUDIT-SOURCE-ERROR-IDLE",
      "from": "Idle",
      "event": "source.error",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "forward error unchanged",
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "A source error terminates and discards any pending value.",
      "obligations": [
        "S7-AUDIT-SOURCE-ERROR-IDLE"
      ]
    },
    {
      "id": "AUDIT-CANCEL-IDLE",
      "from": "Idle",
      "event": "cancel",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "Cancellation does not emit completion or a pending value.",
      "obligations": [
        "S7-AUDIT-CANCEL-IDLE"
      ]
    },
    {
      "id": "AUDIT-SOURCE-ERROR-CALLING",
      "from": "Calling",
      "event": "source.error",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "forward error unchanged",
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "A source error terminates and discards any pending value.",
      "obligations": [
        "S7-AUDIT-SOURCE-ERROR-CALLING"
      ]
    },
    {
      "id": "AUDIT-CANCEL-CALLING",
      "from": "Calling",
      "event": "cancel",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "Cancellation does not emit completion or a pending value.",
      "obligations": [
        "S7-AUDIT-CANCEL-CALLING"
      ]
    },
    {
      "id": "AUDIT-SOURCE-ERROR-PENDING",
      "from": "Pending",
      "event": "source.error",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "forward error unchanged",
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "A source error terminates and discards any pending value.",
      "obligations": [
        "S7-AUDIT-SOURCE-ERROR-PENDING"
      ]
    },
    {
      "id": "AUDIT-CANCEL-PENDING",
      "from": "Pending",
      "event": "cancel",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "Cancellation does not emit completion or a pending value.",
      "obligations": [
        "S7-AUDIT-CANCEL-PENDING"
      ]
    },
    {
      "id": "AUDIT-CANCEL-WAITING",
      "from": "Waiting",
      "event": "cancel",
      "guard": "valid clock and live execution",
      "to": "Closed",
      "actions": [
        "release owned subscriptions/timer without flush"
      ],
      "nextState": "closed with pending value discarded",
      "explanation": "Cancellation does not emit completion or a pending value.",
      "obligations": [
        "S7-AUDIT-CANCEL-WAITING"
      ]
    }
  ]
}
