{
  "name": "rxjs-formal-way",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Traceable RxJS operator specifications and scoped runtime evidence",
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc -p tsconfig.types.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:model": "npm run build && node --test tests/*-model.test.mjs",
    "generate": "npm run build && node scripts/generate.mjs",
    "check:generated": "npm run build && node scripts/generate.mjs --check",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check": "npm run check:syntax && npm run check:types && npm test && npm run check:generated"
  },
  "dependencies": { "rxjs": "7.8.2" },
  "devDependencies": { "typescript": "5.8.3" }
}
